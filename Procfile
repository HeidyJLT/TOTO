# ============================================================
#  Procfile — Instrucción de arranque para Railway
#
#  Railway lee este archivo para saber cómo iniciar
#  el servicio. Sin este archivo Railway no sabe
#  cómo arrancar tu aplicación.
#
#  Formato:  web: <comando de arranque>
#
#  ✏️ MODIFICA AQUÍ: si cambias el puerto o el nombre
#     del módulo principal cambia main:app
# ============================================================
web: uvicorn main:app --host 0.0.0.0 --port $PORT
